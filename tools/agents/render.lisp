(elle/epoch 18)
# audited: 2026-11-23
# Writes one directory's index: its documents with their call-outs, and its subdirectories with their summaries.
# tools/agents/overview.md

(fn []
  (def {:callout callout :rebase rebase} ((import "./callout")))
  (def {:docs-in docs-in :subdirs-in subdirs-in :name-of name-of}
    ((import "./listing")))

  (def marker "Generated by `make agents`. Edit a document, never this index.")

  (defn read-callout [root path]
    "The [title para] of the document at PATH under ROOT."
    (callout (file/read (path/join root path))))

  (defn document [root doc]
    "The entry for DOC: its link, its title and its call-out."
    (let [name (name-of doc)
          [title para] (read-callout root doc)
          title (if (empty? title) name title)]
      (if (empty? para)
        (string "- [" name "](" name ") — **" title " (more...)**")
        (string "- [" name "](" name ") — **" title "** " para))))

  (defn summary [root t sub]
    "What the parent says of SUB: its overview's call-out with each link led
     from the parent, else the titles of the documents in it."
    (let [base (name-of sub)
          overview (path/join root sub "overview.md")]
      (if (path/file? overview)
        (let [[title para] (callout (file/read overview))]
          (if (empty? para)
            (string "**" title " (more...)**")
            (rebase para base)))
        (let [titles (map (fn [doc]
                            (let [[title _] (read-callout root doc)]
                              (if (empty? title) (name-of doc) title)))
                          (docs-in t sub))]
          (if (empty? titles) "(empty)" (string/join (->array titles) ", "))))))

  (defn index [t d]
    "The index of directory D in the tree T, as the text of its file."
    (let [root (get t :root)
          docs (docs-in t d)
          subs (subdirs-in t d)
          @out @[(string "# " (name-of d)) "" marker]]
      (unless (= d ".")
        (push out "")
        (push out "Up: [..](../AGENTS.md)"))
      (unless (empty? docs)
        (push out "")
        (push out "## Documents")
        (push out "")
        (each doc in docs
          (push out (document root doc))))
      (unless (empty? subs)
        (push out "")
        (push out "## Directories")
        (push out "")
        (each sub in subs
          (push out
                (string "- [" (name-of sub) "/](" (name-of sub)
                        "/AGENTS.md) — " (summary root t sub)))))
      (string (string/join out "\n") "\n")))

  (defn owned? [path]
    "Whether the generator may write the index at PATH: there is none, or the
     one there carries the marker in its first four lines."
    (or (not (path/exists? path))
        (let [lines (->array (string/split (file/read path) "\n"))
              head (slice lines 0 (min 4 (length lines)))]
          (any? (fn [l] (string/contains? l "Generated by `make agents`")) head))))

  {:index index :owned? owned?})
