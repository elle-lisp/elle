# audited: 2026-11-23
# What every test of the index generator shares: a fixture tree, git in it, and a run of the tool.
# tools/agents/overview.md
# tests/lang/overview.md
#
# A file that includes this one binds agents, the generator's module, before
# the include. Each run names its root with --root, so no run reads the tree
# the suite runs in unless a test asks for it.

(def marker "Generated by `make agents`. Edit a document, never this index.")

(defn plant [root files]
  "Write FILES, an array of [path text] pairs, under ROOT."
  (each [rel text] in files
    (let [path (path/join root rel)]
      (file/mkdir-all (path/parent path))
      (file/write path text))))

(defn git [dir & args]
  "Run git ARGS in DIR, which must succeed. The configuration is the fixture's
   own, so the user's identity, signing and hooks never reach it."
  (let [r (subprocess/system "git"
                             (concat ["-C" dir "-c" "user.name=fixture" "-c"
                                      "user.email=fixture@example.invalid" "-c"
                                      "commit.gpgsign=false" "-c"
                                      "core.hooksPath=/dev/null" "-c"
                                      "protocol.file.allow=always"]
                                     (->array args)))]
    (assert (= (get r :exit) 0) (string "git " args " failed: " (get r :stderr)))
    (get r :stdout)))

(defn run [root & args]
  "Run the generator over ROOT with ARGS, and answer {:exit :stdout :stderr}."
  (agents:run (concat ["--root" root] (->array args))))

(defn ran [root & args]
  "Run the generator over ROOT with ARGS, which must succeed, and answer its
   stdout."
  (let [r (run root ;args)]
    (assert (= (get r :exit) 0)
            (string "agents " args " exits 0: " (get r :stderr)))
    (get r :stdout)))

(defn index [root dir]
  "The index the generator prints for DIR under ROOT."
  (ran root "--print" dir))

(defn has? [text part]
  "Whether TEXT holds PART."
  (string/contains? text part))

(defn read [root rel]
  "The text of REL under ROOT."
  (file/read (path/join root rel)))

(defn exists? [root rel]
  "Whether REL exists under ROOT."
  (path/exists? (path/join root rel)))
