(elle/epoch 16)
# audited: 2026-11-17
# One example of each core form compiles and evaluates to its value.
# docs/pipeline.md
#
# The compiler is deterministic or it is not, and varying the values finds no
# more nondeterminism than one example per form does.

# ============================================================================
# Arithmetic
# ============================================================================

(assert (= (+ 37 -82) -45) "arithmetic: (+ 37 -82) == -45")

# ============================================================================
# Let binding
# ============================================================================

(assert (= (let [x 42
                 y -17]
             (+ x y)) 25) "let: (let ((x 42) (y -17)) (+ x y)) == 25")

# ============================================================================
# Lambda
# ============================================================================

(assert (= ((fn (x) (* x 2)) 21) 42) "lambda: ((fn (x) (* x 2)) 21) == 42")

# ============================================================================
# Multi-form
# ============================================================================

(begin
  (def det-x 13)
  (def det-y -8)
  (assert (= (+ det-x det-y) 5)
          "multi_form: (begin (def det-x 13) (def det-y -8) (+ det-x det-y)) == 5"))

# ============================================================================
# Closure
# ============================================================================

(assert (= (let [captured 10]
             ((fn (x) (+ x captured)) 32)) 42)
        "closure: (let ((captured 10)) ((fn (x) (+ x captured)) 32)) == 42")

# ============================================================================
# Conditional
# ============================================================================

(assert (= (if (< -5 10) -5 10) -5) "conditional: (if (< -5 10) -5 10) == -5")

# ============================================================================
# Recursive function
# ============================================================================

(defn factorial [n]
  "Compute factorial of n"
  (if (<= n 1)
    1
    (* n (factorial (- n 1)))))

(assert (= (factorial 7) 5040) "recursive: factorial of 7 == 5040")

# ============================================================================
# String operation
# ============================================================================

(assert (= (length "hello") 5) "string_op: (length \"hello\") == 5")
