digraph refcount_protocol {
    rankdir=TB;
    node [shape=box, style=filled, fontname="monospace", fontsize=10];
    edge [fontname="monospace", fontsize=9];

    // ── Completed infrastructure ─────────────────────────────────
    infra [label="Infrastructure (all done):\n• StoreLocal incref\n• StoreLocalRefcounted decref+incref\n• DecrefLocal bytecode + emission\n• DropSlot decref+drop (escape-gated)\n• Intrusive linked list (O(1) unlink)\n• Refcounted rotation (accept suspend)\n• Result-protection slots\n• release() → release_refcounted()\n• Alloc-time child incref\n• Decref-on-free for children\n• --trace=rc\n• Tier 14 leak tests", fillcolor="#99ff99"];

    // ── What passes ──────────────────────────────────────────────
    pass [label="PASS (DecrefLocal disabled):\nALL tests pass\nincluding telemetry.lisp", fillcolor="#99ff99"];

    // ── What fails ───────────────────────────────────────────────
    fail [label="FAIL (DecrefLocal enabled):\ntelemetry.lisp UAF\nleak.lisp tier 14 passes\nresource.lisp passes\nhttp2 passes", fillcolor="#ff9999", penwidth=3];

    // ── Root cause ───────────────────────────────────────────────
    cause [label="DecrefLocal drops binding rc → 0\nrelease_refcounted frees the value\nBUT: value is a struct child of\nanother live value, and the child\nincref balance is wrong.\n\nThe child was incref'd at alloc time\nbut also decref'd somewhere before\nthe parent scope exits.", fillcolor="#ffcccc"];

    // ── Investigation needed ─────────────────────────────────────
    invest [label="INVESTIGATE:\n1. Trace rc of specific metrics[1]\n   value through its lifecycle\n2. Find which decref drops it to 0\n   before release_refcounted\n3. Check freeze/thaw incref balance\n   (freeze creates new array from\n   @array — children incref'd twice?)", fillcolor="#cce5ff"];

    // ── Edges ────────────────────────────────────────────────────
    infra -> pass [label="without\nDecrefLocal"];
    infra -> fail [label="with\nDecrefLocal"];
    fail -> cause -> invest;
}
