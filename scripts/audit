#!/usr/bin/env bash
# audited: 2026-10-08
# Names the files whose stale documentation costs the most, and gates a commit
# on the files it stages carrying today's stamp.
# docs/impl/audit.md
set -euo pipefail

usage() {
    cat <<'EOF'
scripts/audit — what to audit next

usage:
  scripts/audit                  the ten costliest files, and the counts
  scripts/audit --next N         the N files to audit next
  scripts/audit --all            every file, costliest first
  scripts/audit --stale DAYS     every file stamped longer ago than DAYS
  scripts/audit --policy         every file stamped before the policy itself
  scripts/audit --counts         how many files carry no stamp, and how many
                                 carry one older than the policy's
  scripts/audit --staged [PATH…] fail when a file carries no stamp for today
  scripts/audit --root DIR       treat DIR as the repository root
  scripts/audit --help           this text

A source file stamps itself in its header comment, a document in an HTML
comment under its title:

  // audited: 2026-09-04
  <!-- audited: 2026-09-04 -->

Apply DOCUMENTATION.md to a file, then stamp today's date. A file that breaks a
rule carries no stamp until the rule is met.
EOF
}

root=$(cd "$(dirname "$0")/.." && pwd)
mode=""
arg=""
paths=()

while [ $# -gt 0 ]; do
    case "$1" in
        --root) root=$(cd "$2" && pwd); shift 2 ;;
        --help | -h) usage; exit 0 ;;
        --next | --stale) mode="$1"; arg="${2:-}"; shift 2 ;;
        --all | --policy | --counts | --staged) mode="$1"; shift ;;
        --*) usage >&2; exit 2 ;;
        *) paths+=("$1"); shift ;;
    esac
done

# Whether one path carries a stamp. The staged gate and the tree walk ask the
# same question here, so they cannot disagree about what is exempt — a file the
# gate skipped but the walk counted would sit in the queue forever with no
# commit able to clear it.
eligible() {
    case "$1" in
        .git/* | target/* | node_modules/* | plugins/*) return 1 ;;
        CLAUDE.md | */CLAUDE.md) return 1 ;;
    esac
    # An index the generator owns is exempt, because its generator is what
    # gets audited. A hand-written one holds knowledge somebody wrote and is
    # queued like any other document — the root AGENTS.md most of all, since
    # every session reads it.
    case "$1" in
        AGENTS.md | */AGENTS.md)
            if header_has "$root/$1" 4 'Generated by `scripts/agents`'; then
                return 1
            fi
            ;;
    esac
    local dir=.
    case "$1" in */*) dir=${1%/*} ;; esac
    if vendored "$dir"; then return 1; fi
    # Every file queued here is read whole by somebody. A makefile is read
    # through `make help`, one `##` line at a time, the standard library
    # through `(doc name)`, one docstring at a time, and the LIR instruction
    # enum one variant at a time, from a match arm. None of the three is
    # queued. Each is named by path so every file beside it stays. See
    # docs/impl/audit.md.
    case "$1" in
        src/stdlib.lisp | src/lir/code/instr.rs) return 1 ;;
        scripts/* | *.rs | *.lisp | *.md) return 0 ;;
        *) return 1 ;;
    esac
}

# A directory below the root that carries its own licence is vendored. The
# tree already states this, so reading it beats a list of paths in here that
# goes wrong the first time a dependency moves.
#
# The walk stops before the root: the repository's own LICENSE covers the
# repository, and treating it as a vendor marker empties the queue entirely.
vendored() {
    local d="$1"
    while [ -n "$d" ] && [ "$d" != "." ] && [ "$d" != "/" ]; do
        if [ -e "$root/$d/COPYRIGHT" ] || compgen -G "$root/$d/LICENSE*" >/dev/null 2>&1; then
            return 0
        fi
        case "$d" in */*) d=${d%/*} ;; *) d=. ;; esac
    done
    return 1
}

# Whether one of the first N lines of FILE matches the extended regex RE, with
# BASH_REMATCH holding the match. The walk asks this of every file, so it reads
# with builtins and starts no process (docs/impl/audit.md).
#
# The `|| [ -n "$line" ]` reads a last line that has no newline, which `read`
# returns along with a failure.
header_has() {
    local file=$1 n=$2 re=$3 line
    [ -r "$file" ] || return 1
    while [ "$n" -gt 0 ] && { IFS= read -r line || [ -n "$line" ]; }; do
        if [[ $line =~ $re ]]; then return 0; fi
        n=$((n - 1))
    done <"$file"
    return 1
}

# Set `stamp` to the stamp date on one file, or to empty. The stamp lives in
# the first few lines. A variable rather than output, because `$(…)` would fork
# a subshell for every file.
stamp_of() {
    stamp=""
    if header_has "$1" 8 'audited: ([0-9]{4}-[0-9]{2}-[0-9]{2})'; then
        stamp=${BASH_REMATCH[1]}
    fi
}

# Days between an ISO date and today, by Julian day number in awk.
#
# BSD date has no `-d`, and CI runs macos-latest, so converting a stamp with
# `date -d "$stamp" +%s` is green here and broken there. The arithmetic needs
# no date(1) at all beyond today, which `+%F` gives on both.
#
# An absent or unparseable stamp takes 3650 days, which outranks any real age
# and keeps a never-audited file ahead of a stamped one at equal cost.
days_since() {
    awk -v stamp="$1" -v today="$(date +%F)" '
        function jdn(y, m, d,   a, yy, mm) {
            a = int((14 - m) / 12); yy = y + 4800 - a; mm = m + 12 * a - 3
            return d + int((153 * mm + 2) / 5) + 365 * yy \
                 + int(yy / 4) - int(yy / 100) + int(yy / 400) - 32045
        }
        BEGIN {
            if (stamp !~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) { print 3650; exit }
            split(stamp, s, "-"); split(today, t, "-")
            age = jdn(t[1], t[2], t[3]) - jdn(s[1], s[2], s[3])
            print (age < 0 ? 0 : age)
        }'
}

# Every file that may carry a stamp, relative to the root: the files git tracks
# when the root is the top of a work tree, and every file under it otherwise.
#
# Only the top counts. A fixture tree below some other repository's top is
# untracked there, so asking git would answer an empty list.
candidates() {
    cd "$root"
    local cdup
    if cdup=$(git rev-parse --show-cdup 2>/dev/null) && [ -z "$cdup" ]; then
        git -c core.quotePath=false ls-files -- '*.rs' '*.lisp' '*.md' 'scripts/*'
        return
    fi
    find . -type f \
        \( -name '*.rs' -o -name '*.lisp' -o -name '*.md' \) \
        -not -path './.git/*' -not -path './target/*' \
        -not -path './node_modules/*' -not -path './plugins/*' \
        | sed 's|^\./||'
    find . -path './scripts/*' -type f 2>/dev/null | sed 's|^\./||' || true
}

# cost = bytes / (depth + 1), ranked by cost * staleness.
#
# Depth stands in for how often a file is read, which is the quantity that
# matters and which nothing measures directly. Ranking by stamp age alone puts
# a never-audited leaf ahead of a large root document somebody last read a year
# ago, and the leaf is the one whose staleness costs nobody anything.
ranked() {
    cd "$root"
    local f bytes depth stamp age cost
    while read -r f; do
        [ -n "$f" ] || continue
        eligible "$f" || continue
        [ -f "$f" ] || continue
        bytes=$(wc -c <"$f")
        depth=$(printf '%s' "$f" | tr -cd '/' | wc -c)
        stamp_of "$f"
        age=$(days_since "$stamp")
        cost=$((bytes / (depth + 1)))
        printf '%d\t%s\t%s\n' "$((cost * age))" "${stamp:-never}" "$f"
    done < <(candidates | sort -u) | sort -rn
}

show() { awk -F'\t' '{ printf "%-12s %s\n", $2, $3 }'; }

# The policy carries a stamp like any other document. A file stamped before it
# has never met the current rules, however recently somebody read it.
policy_floor() {
    local stamp
    stamp_of "$root/DOCUMENTATION.md"
    [ -n "$stamp" ] || { echo "DOCUMENTATION.md carries no stamp" >&2; exit 1; }
    printf '%s\n' "$stamp"
}

case "$mode" in
    --staged)
        today=$(date +%F)
        cd "$root"
        # A read loop, because `mapfile` is bash 4+ and macOS ships 3.2.
        if [ ${#paths[@]} -eq 0 ]; then
            while IFS= read -r line; do
                paths+=("$line")
            done < <(git diff --cached --name-only --diff-filter=ACM)
        fi
        stale=()
        for f in ${paths+"${paths[@]}"}; do
            eligible "$f" || continue
            [ -f "$f" ] || continue
            header_has "$f" 8 "audited: $today" || stale+=("$f")
        done
        if [ ${#stale[@]} -gt 0 ]; then
            echo "audit: these files changed today and carry no stamp for $today:" >&2
            printf '  %s\n' "${stale[@]}" >&2
            echo >&2
            echo "read each one whole, apply DOCUMENTATION.md, then stamp it." >&2
            exit 1
        fi
        ;;
    --policy)
        # This is the set a policy change has not yet reached.
        floor=$(policy_floor)
        ranked | awk -F'\t' -v floor="$floor" '$2 == "never" || $2 < floor' | show
        ;;
    --counts)
        # The two counts the ratchet pins. No file is in both, and neither
        # needs the ranking, whose cost per file is most of a walk.
        floor=$(policy_floor)
        cd "$root"
        unstamped=0
        before=0
        while read -r f; do
            [ -n "$f" ] || continue
            eligible "$f" || continue
            [ -f "$f" ] || continue
            stamp_of "$f"
            if [ -z "$stamp" ]; then
                unstamped=$((unstamped + 1))
            elif [[ "$stamp" < "$floor" ]]; then
                before=$((before + 1))
            fi
        done < <(candidates | sort -u)
        printf 'unstamped %d\nbefore-policy %d\n' "$unstamped" "$before"
        ;;
    --all) ranked | show ;;
    # awk, not head: a reader that exits early kills the writer with SIGPIPE,
    # and `pipefail` turns that into exit 141 once the queue outgrows the pipe.
    --next) ranked | awk -v n="${arg:-5}" 'NR <= n' | show ;;
    --stale)
        # Compared as day counts, not as a cutoff date, so no date arithmetic
        # is needed beyond what `days_since` already does portably.
        ranked | while IFS=$'\t' read -r rank stamp path; do
            [ "$(days_since "${stamp#never}")" -gt "${arg:-90}" ] || continue
            printf '%s\t%s\t%s\n' "$rank" "$stamp" "$path"
        done | show
        ;;
    *)
        all=$(ranked)
        total=$(printf '%s\n' "$all" | grep -c . || true)
        never=$(printf '%s\n' "$all" | awk -F'\t' '$2 == "never"' | grep -c . || true)
        echo "$total files want a stamp; $never have never been audited."
        echo
        printf '%s\n' "$all" | awk 'NR <= 10' | show
        echo
        echo "next: scripts/audit --next 20"
        ;;
esac
