#!/usr/bin/env bash
# audited: 2026-10-23
# Counts the hand-written AGENTS.md files below the root, and the rows in them that name a file.
# docs/impl/agents-index.md
set -euo pipefail

usage() {
    cat <<'EOF'
scripts/unconverted — what the generated index has yet to take

usage:
  scripts/unconverted            print `hand-written N` and `file-rows N`
  scripts/unconverted --root DIR treat DIR as the repository root
  scripts/unconverted --help     this text

`scripts/agents --counts` runs this, and so do its check and its write.
EOF
}

root=$(cd "$(dirname "$0")/.." && pwd)

while [ $# -gt 0 ]; do
    case "$1" in
        --root) root=$(cd "$2" && pwd); shift 2 ;;
        --help | -h) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done

# Every AGENTS.md below the root, relative to it: the files git tracks when the
# root is the top of a work tree, and every file under it otherwise. Two
# checkouts of one commit then count alike, whichever submodules each holds.
indexes() {
    local cdup
    if cdup=$(cd "$root" && git rev-parse --show-cdup 2>/dev/null) && [ -z "$cdup" ]; then
        (cd "$root" && git -c core.quotePath=false ls-files -- '*/AGENTS.md')
        return
    fi
    find "$root" -mindepth 2 -type f -name AGENTS.md \
        -not -path '*/.git/*' -not -path '*/target/*' -not -path '*/node_modules/*' \
        | sed "s|^$root/||"
}

# The two counts the ratchet pins: the indexes that carry no generated marker,
# which no run may write, and the table rows in them whose first cell names a
# file. A first cell names a file when it is a link, or a code span ending in
# an extension or in `/`; `io/submit` is a primitive's name.
hand=0
files=()
while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$root/$f" ] || continue
    head -4 "$root/$f" | grep -q 'Generated by `scripts/agents`' && continue
    hand=$((hand + 1))
    files+=("$root/$f")
done < <(indexes)
printf 'hand-written %d\n' "$hand"
# awk with no file reads stdin, so an empty list prints its zero here.
if [ "$hand" -eq 0 ]; then
    printf 'file-rows 0\n'
    exit 0
fi
awk '
    BEGIN {
        row = "^\\|[[:space:]]*(\\[[^]]*\\]\\([^)]*\\)|`[^`|]*(\\.[A-Za-z0-9]+|[^`|/]/)`)[[:space:]]*\\|"
    }
    $0 ~ row { n++ }
    END { printf "file-rows %d\n", n }
' "${files[@]}"
