#!/usr/bin/env bash
# audited: 2026-10-20
# Records or checks the bytecode golden, and checks that an image boot compiles the corpus as a source boot does.
# docs/config.md
# docs/impl/image/plan.md
# docs/impl/image/boot.md
#
# The golden is what one binary's emitter wrote. A representation change that
# must not move one instruction records with the binary before it, and checks
# with the binary after it. Every run turns the stdlib cache and the boot image
# off, so a source boot compiles the standard library and mints its static
# region slots before the file's own, and two runs number them alike. A release
# binary carries a blob it would otherwise hydrate. An image boot names its
# image after that, mints none of the slots, and starts the counter at the
# image's watermark instead.
set -euo pipefail

usage() {
    cat <<'EOF'
scripts/bytecode-golden — record or compare the bytecode golden

usage:
  scripts/bytecode-golden record ELLE DIR [JOBS]   write one dump per file into DIR
  scripts/bytecode-golden check  ELLE DIR [JOBS]   compare ELLE's dumps with DIR
  scripts/bytecode-golden parity ELLE DIR [JOBS]   compare ELLE's dumps under a
                                                   source boot and an image boot

The files are tests/lang/*.lisp, tests/impl/*.lisp and src/stdlib.lisp. Each
record holds the dump's stdout, then its stderr and exit status, so a file that
fails to compile records its error and still has to fail the same way.

parity stores a boot image under DIR/boot, refuses to go on unless the next
start hydrates it, and then dumps every file twice: into DIR/source under a
source boot and into DIR/image under the image. It removes DIR when the two
agree, and keeps it to diff when they do not.
EOF
}

[ $# -ge 3 ] || { usage >&2; exit 2; }
mode="$1"
elle="$2"
dir="$3"
jobs="${4:-8}"

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

[ -x "$elle" ] || { echo "bytecode-golden: no executable at $elle" >&2; exit 2; }

# One dump: the file's path names its record, with every `/` spelled `__`.
# `flag` is one more argument for the binary, or empty for none. It follows
# `--boot-image=off`, so a `--boot-image=` flag is the one the binary keeps.
dump_one() {
    local elle="$1" out="$2" flag="$3" file="$4"
    local name="${file//\//__}"
    local rec="$out/$name.txt"
    local status=0
    "$elle" --cache= --boot-image=off ${flag:+"$flag"} --dump=bytecode "$file" >"$rec.stdout" 2>"$rec.stderr" || status=$?
    {
        cat "$rec.stdout"
        echo ";; ── stderr"
        cat "$rec.stderr"
        echo ";; ── exit $status"
    } >"$rec"
    rm -f "$rec.stdout" "$rec.stderr"
}
export -f dump_one

# The dumps of every file, into `out`, each run with `flag` (may be empty).
dump_all() {
    local out="$1" flag="${2:-}"
    rm -rf "$out"
    mkdir -p "$out"
    {
        ls tests/lang/*.lisp tests/impl/*.lisp
        echo src/stdlib.lisp
    } | xargs -P "$jobs" -I{} bash -c 'dump_one "$@"' _ "$elle" "$out" "$flag" {}
}

case "$mode" in
    record)
        dump_all "$dir"
        echo "bytecode-golden: recorded $(ls "$dir" | wc -l) dumps in $dir"
        ;;
    check)
        [ -d "$dir" ] || { echo "bytecode-golden: no record at $dir; run record first" >&2; exit 2; }
        fresh="$dir.check"
        dump_all "$fresh"
        if diff -rq "$dir" "$fresh" >"$fresh.diff" 2>&1; then
            echo "bytecode-golden: $(ls "$fresh" | wc -l) dumps identical to $dir"
            rm -rf "$fresh" "$fresh.diff"
        else
            echo "bytecode-golden: dumps differ from $dir:" >&2
            cat "$fresh.diff" >&2
            echo "bytecode-golden: the fresh dumps are in $fresh" >&2
            exit 1
        fi
        ;;
    parity)
        rm -rf "$dir"
        mkdir -p "$dir"
        image="--boot-image=$dir/boot"
        # The first start meets an empty directory, so it compiles the three
        # sources and stores the image every later start reads. The second has
        # to print the hydration mark: a binary that ignored the flag, or an
        # image every start refused, would leave two source boots to compare,
        # and those always agree.
        "$elle" --cache= "$image" -e '(+ 1 2)' >/dev/null
        trace=$("$elle" --cache= "$image" --trace=boot -e '(+ 1 2)' 2>&1 >/dev/null) || true
        if ! printf '%s\n' "$trace" | grep -q 'image-hydrate'; then
            printf '%s\n' "$trace" >&2
            echo "bytecode-parity: the second start did not hydrate the stored image, so both dumps would come from a source boot" >&2
            exit 1
        fi
        dump_all "$dir/source"
        dump_all "$dir/image" "$image"
        if diff -rq "$dir/source" "$dir/image" >"$dir/diff" 2>&1; then
            echo "bytecode-parity: $(ls "$dir/source" | wc -l) dumps identical under a source boot and an image boot"
            rm -rf "$dir"
        else
            echo "bytecode-parity: an image boot compiles these files to other bytecode:" >&2
            cat "$dir/diff" >&2
            echo "bytecode-parity: the dumps are in $dir/source and $dir/image" >&2
            exit 1
        fi
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
