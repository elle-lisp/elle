#!/usr/bin/env bash
# audited: 2026-10-22
# Builds a directory's AGENTS.md from the call-out sentence of every document
# in it, so the index cannot rot and cannot be posted to.
# docs/impl/agents-index.md
set -euo pipefail

usage() {
    cat <<'EOF'
scripts/agents — build AGENTS.md from every document in a directory

usage:
  scripts/agents [DIR]         write the index for DIR and everything below it
  scripts/agents --print DIR   write DIR's index to stdout
  scripts/agents --check [DIR] exit 1 when a committed index is stale
  scripts/agents --root DIR    treat DIR as the repository root
  scripts/agents --help        this text

An entry is a document's link, its `# Title` and its call-out — the first
sentence of the first paragraph under that title. A document with no call-out,
or one over the budget, is listed as uncalled, which is the work queue.
EOF
}

root=$(cd "$(dirname "$0")/.." && pwd)
mode="write"
dir=""

while [ $# -gt 0 ]; do
    case "$1" in
        --root) root=$(cd "$2" && pwd); shift 2 ;;
        --help | -h) usage; exit 0 ;;
        --print | --check) mode="${1#--}"; shift ;;
        --*) usage >&2; exit 2 ;;
        *) dir="$1"; shift ;;
    esac
done

# What one entry may spend. A call-out is one sentence a reader takes in at a
# glance, and every entry competes for the attention of the same scan.
budget=140

# The first `# ` line is the title; the call-out is the first sentence of the
# paragraph under it. Documents hard-wrap, so the paragraph joins before it
# cuts — reading a single line would truncate at the wrap.
callout() {
    awk -v budget="$budget" '
        /^<!--/ { next }
        /^# / && !title { sub(/^# /, ""); title = $0; next }
        title && !done {
            if (/^[[:space:]]*$/) { if (para) done = 1; next }
            # A heading, list, table or quote reached before any prose ends the
            # search: the document opens straight into structure and has no
            # call-out. Skipping ahead instead would quote a paragraph from
            # further down, which reads as a summary the author never wrote.
            if (/^[#>|-]/ || /^[[:space:]]/) { done = 1; next }
            para = para ? para " " $0 : $0
        }
        END {
            if (match(para, /\.[[:space:]]/)) para = substr(para, 1, RSTART)
            printf "%s\t%s\n", title, (length(para) > budget ? "" : para)
        }
    ' "$1"
}

# Every file the indexes may name, as paths relative to the root. At the top of
# a git work tree that is what git tracks, so the index a checkout writes is the
# index CI checks: an ignored note, a build output and a submodule stay out.
# Elsewhere, such as in a test fixture, it is every file. Either way a path must
# still be a file on disk, and no component may start with a dot.
list_files() {
    local cdup path
    if cdup=$(git -C "$root" rev-parse --show-cdup 2>/dev/null) && [ -z "$cdup" ]; then
        git -C "$root" -c core.quotePath=false ls-files
    else
        (cd "$root" && find . \( -name target -o -name node_modules \) -prune \
            -o -type f -print | sed 's|^\./||')
    fi | awk '!/(^|\/)\./' | while IFS= read -r path; do
        if [ -f "$root/$path" ]; then printf '%s\n' "$path"; fi
    done | LC_ALL=C sort -u
}

listing=$(list_files)

# The listing's paths under directory `$1`, with the directory's prefix cut.
under() {
    if [ "$1" = "." ]; then
        printf '%s\n' "$listing"
    else
        printf '%s\n' "$listing" | awk -v p="$1/" 'index($0, p) == 1 { print substr($0, length(p) + 1) }'
    fi
}

# The path of `$2` inside directory `$1`.
path_in() { if [ "$1" = "." ]; then printf '%s\n' "$2"; else printf '%s\n' "$1/$2"; fi; }

# Documents in one directory, excluding the index itself.
docs_in() {
    under "$1" | awk '!/\// && /\.md$/ && $0 != "AGENTS.md" && $0 != "CLAUDE.md"' \
        | while IFS= read -r name; do path_in "$1" "$name"; done
}

subdirs_in() {
    under "$1" | awk -F/ 'NF > 1 { print $1 }' | LC_ALL=C sort -u \
        | while IFS= read -r name; do path_in "$1" "$name"; done
}

index() {
    local d="$1" doc name title para sub base
    if [ "$d" = "." ]; then echo "# root"; else echo "# $(basename "$d")"; fi
    echo
    echo "Generated by \`scripts/agents\`. Edit a document, never this index."
    if [ "$d" != "." ]; then
        echo
        echo "Up: [..](../AGENTS.md)"
    fi

    if [ -n "$(docs_in "$d")" ]; then
        echo
        echo "## Documents"
        echo
        while read -r doc; do
            [ -n "$doc" ] || continue
            name=$(basename "$doc")
            IFS=$'\t' read -r title para < <(callout "$root/$doc")
            [ -n "$title" ] || title="$name"
            if [ -n "$para" ]; then
                echo "- [$name]($name) — **$title** $para"
            else
                echo "- [$name]($name) — **$title (more...)**"
            fi
        done < <(docs_in "$d")
    fi

    if [ -n "$(subdirs_in "$d")" ]; then
        echo
        echo "## Directories"
        echo
        while read -r sub; do
            [ -n "$sub" ] || continue
            base=$(basename "$sub")
            if [ -f "$root/$sub/overview.md" ]; then
                IFS=$'\t' read -r title para < <(callout "$root/$sub/overview.md")
                echo "- [$base/]($base/AGENTS.md) — ${para:-**$title (more...)**}"
            else
                # No overview.md, so the parent lists what is inside. Worse
                # than a summary, better than a bare name, and it asks no
                # judgment of the generator.
                titles=""
                while read -r doc; do
                    [ -n "$doc" ] || continue
                    IFS=$'\t' read -r title para < <(callout "$root/$doc")
                    titles="${titles:+$titles, }${title:-$(basename "$doc")}"
                done < <(docs_in "$sub")
                echo "- [$base/]($base/AGENTS.md) — ${titles:-(empty)}"
            fi
        done < <(subdirs_in "$d")
    fi
}

# Whether the generator may write this index: either there is none, or the one
# there carries the marker this script writes.
#
# Without the check, the first run over a repository that still keeps its
# module knowledge in AGENTS.md destroys all of it, and the loss reads as a
# successful build. Converting a directory is a deliberate act: move the
# knowledge to a leaf, delete the old index, and the generator takes it.
owned() {
    [ -e "$1" ] || return 0
    head -4 "$1" | grep -q 'Generated by `scripts/agents`'
}

# Every directory at or below `d` that holds a listed file.
tree_of() {
    local d="$1"
    printf '%s\n' "$d"
    under "$d" | awk -F/ '{ p = ""; for (i = 1; i < NF; i++) { p = p (i > 1 ? "/" : "") $i; print p } }' \
        | LC_ALL=C sort -u | while IFS= read -r sub; do path_in "$d" "$sub"; done
}

dir="${dir:-.}"
dir="${dir#./}"
dir="${dir%/}"
[ -n "$dir" ] || dir="."

case "$mode" in
    print) index "${dir:-.}" ;;
    check)
        rc=0
        while read -r d; do
            [ -n "$(docs_in "${d:-.}")" ] || continue
            target="$root/${d:+$d/}AGENTS.md"
            # Same ownership rule as the write path. A directory still holding
            # a hand-written index is unconverted, not stale.
            owned "$target" || continue
            if ! diff -q <(index "${d:-.}") "$target" >/dev/null 2>&1; then
                echo "AGENTS.md is stale in ${d:-.} — run: make agents" >&2
                rc=1
            fi
        done < <(tree_of "${dir:-.}")
        exit $rc
        ;;
    write)
        n=0
        skipped=0
        while read -r d; do
            [ -n "$(docs_in "${d:-.}")" ] || continue
            target="$root/${d:+$d/}AGENTS.md"
            if ! owned "$target"; then
                echo "skipped ${d:-.}: hand-written AGENTS.md" >&2
                skipped=$((skipped + 1))
                continue
            fi
            index "${d:-.}" >"$target"
            n=$((n + 1))
        done < <(tree_of "${dir:-.}")
        echo "wrote $n indexes; skipped $skipped hand-written"
        ;;
esac
