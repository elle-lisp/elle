#!/bin/sh
# Pre-commit hook:
#   1. Gate on the audit stamp: every staged file carries today's date.
#   2. Rebuild the generated AGENTS.md indexes and stage what changed.
#   3. Format the staged content of each .lisp file with `elle fmt` and stage
#      it. `elle fmt` also migrates a file that declares an older epoch.
#   4. Format the staged content of each .rs file with `rustfmt` and stage it.
#   5. If staged .rs files exist, gate on clippy / rustdoc — the `make test`
#      checks that CAN'T be auto-fixed, scoped to Rust-touching commits so
#      Lisp-only commits don't pay the Cargo cost.
#
# Formatting is fixed, never gated: an unformatted file is reformatted and
# re-staged, not rejected. CI's `make fmt-check` is the hard format gate (CI
# can't rewrite your tree); the local hook just keeps every commit clean. A
# file the formatter cannot read refuses the commit.
#
# The hook formats what is staged, never the working copy, so a hunk left
# unstaged stays out of the commit. It formats the working copy on disk as well.
#
# A partial commit, `git commit -- <paths>`, runs this hook against a temporary
# index. A change staged here reaches only that index, so it would land in HEAD
# and leave the real index holding the unfixed file, which the next commit from
# the index would put back. In a partial commit the hook therefore leaves its
# fixes on disk and refuses the commit, naming the files.

# ── Audit stamp ─────────────────────────────────────────────────────
# Touch a file, audit it (DOCUMENTATION.md). Read it whole, hold it to the
# policy, then stamp today's date. This runs first so a missing stamp costs
# nothing to discover.
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! ./scripts/audit --staged; then
  exit 1
fi

# ── Partial commit ──────────────────────────────────────────────────
# Git names the index it commits from in GIT_INDEX_FILE: the real index for a
# plain commit, its lock file for `commit -a`, and a file of its own for a
# partial commit. `--git-path index` answers GIT_INDEX_FILE when that is set,
# so the real index is asked for with it unset.
absolute() {
  (cd "$(dirname "$1")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$1")")
}
partial=false
if [ -n "$GIT_INDEX_FILE" ]; then
  real_index=$(absolute "$(unset GIT_INDEX_FILE; git rev-parse --git-path index)")
  commit_index=$(absolute "$GIT_INDEX_FILE")
  if [ "$commit_index" != "$real_index" ] && [ "$commit_index" != "$real_index.lock" ]; then
    partial=true
  fi
fi

# In a partial commit, hold a file the hook changed for the refusal below and
# answer true. Otherwise answer false, and the caller stages the change.
refused=""
held() {
  if $partial; then
    refused="$refused $1"
    return 0
  fi
  return 1
}

# ── Generated indexes ───────────────────────────────────────────────
# Rebuild every AGENTS.md the generator owns and re-stage what changed. Fixed,
# never gated, exactly like the formatters below: an index is derived, so a
# stale one is a thing to rewrite rather than a thing to reject. CI's
# `make agents-check` is the hard gate, because CI cannot rewrite your tree.
#
# scripts/agents refuses any directory still holding a hand-written AGENTS.md,
# so this cannot eat module knowledge that has not been converted yet.
./scripts/agents >/dev/null 2>&1
for f in $(git diff --name-only --diff-filter=ACM -- '*AGENTS.md'); do
  held "$f" || git add "$f"
done

# ── Formatting ──────────────────────────────────────────────────────
scratch=$(mktemp -d) || exit 1
trap 'rm -rf "$scratch"' EXIT

# format_staged FILE FORMATTER...: run the staged content of FILE through a
# formatter that reads stdin and writes stdout, and stage the result.
#
# A working copy that matched the index takes the same result. One that holds
# unstaged changes is formatted on its own, and left as it is when the
# formatter cannot read it: the commit does not include that content.
format_staged() {
  f=$1
  shift
  if ! git show ":$f" | "$@" >"$scratch/staged"; then
    echo "pre-commit: cannot format the staged content of $f." >&2
    exit 1
  fi
  blob=$(git hash-object -w --path="$f" "$scratch/staged")
  if [ "$blob" = "$(git rev-parse ":$f")" ]; then
    return
  fi
  if git diff --quiet -- "$f"; then
    cp "$scratch/staged" "$f"
  elif "$@" <"$f" >"$scratch/working"; then
    cp "$scratch/working" "$f"
  else
    echo "pre-commit: left the unstaged copy of $f unformatted." >&2
  fi
  held "$f" && return
  mode=$(git ls-files --stage -- "$f" | cut -d' ' -f1)
  git update-index --cacheinfo "$mode,$blob,$f"
}

# ── Lisp ────────────────────────────────────────────────────────────
if [ -n "$ELLE" ]; then
  ELLE="$ELLE"
elif [ -x ./target/release/elle ]; then
  ELLE=./target/release/elle
elif [ -x ./target/debug/elle ]; then
  ELLE=./target/debug/elle
else
  ELLE=elle
fi

for f in $(git diff --cached --name-only --diff-filter=ACM -- '*.lisp'); do
  format_staged "$f" "$ELLE" fmt
done

# ── Rust ────────────────────────────────────────────────────────────
# rustfmt reads stdin with no crate around it, so the hook names the edition
# of the nearest Cargo.toml that declares one. Cargo's own default is 2015.
edition_of() {
  d=$(dirname "$1")
  while :; do
    if [ -f "$d/Cargo.toml" ]; then
      e=$(sed -n 's/^edition *= *"\([0-9]*\)".*/\1/p' "$d/Cargo.toml" | head -1)
      if [ -n "$e" ]; then
        echo "$e"
        return
      fi
    fi
    [ "$d" = "." ] && break
    d=$(dirname "$d")
  done
  echo 2015
}

staged_rs=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')
for f in $staged_rs; do
  format_staged "$f" rustfmt --edition "$(edition_of "$f")" --emit stdout
done

# ── Refusal ─────────────────────────────────────────────────────────
if [ -n "$refused" ]; then
  echo "pre-commit: this partial commit cannot take the hook's changes to:" >&2
  for f in $refused; do
    echo "  $f" >&2
  done
  echo "The changes are on disk. Name each file in the commit, then run it again." >&2
  exit 1
fi

# ── Rust gates ──────────────────────────────────────────────────────
if [ -n "$staged_rs" ]; then
  if ! cargo clippy --workspace --all-targets --all-features -- -D warnings; then
    echo "pre-commit: clippy failed. Fix warnings and re-stage."
    exit 1
  fi

  if ! RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps; then
    echo "pre-commit: rustdoc failed. Fix doc warnings and re-stage."
    exit 1
  fi
fi
